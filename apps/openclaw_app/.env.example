APP_ENV=dev
DEBUG=true
FORCE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/openclaw_app
REDIS_URL=redis://redis:6379/0
LITELLM_BASE_URL=http://litellm:4000
SANDBOX_IMAGE=shellclaw-sandbox:latest
SANDBOX_NETWORK=ops_default
SANDBOX_TASK_MODE=openclaw
GLM_API_KEY=
SANDBOX_COMMAND_TEMPLATE=bash -lc 'set -o pipefail; /home/es/.npm-global/bin/openclaw agent --local --agent main --message "{message}" --json --timeout 120 | python3 -c "import sys; data=sys.stdin.read(); start=data.rfind(\"{{\"); print(data[start:] if start != -1 else data)"'
FREE_DAILY_TASK_LIMIT=5
SANDBOX_IDLE_PAUSE_MINUTES=15
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
TASK_EVENTS_CHANNEL_PREFIX=task-events
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUIRE_ACTIVATION_CODE=true
PLANS_CONFIG_PATH=/app/app/config/plans.json
BILLING_DEFAULT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
AUTH_RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
REDEEM_RATE_LIMIT_WINDOW_SEC=300
REDEEM_RATE_LIMIT_MAX_ATTEMPTS=15
CHECKOUT_RATE_LIMIT_WINDOW_SEC=300
CHECKOUT_RATE_LIMIT_MAX_ATTEMPTS=20
