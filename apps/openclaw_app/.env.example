APP_ENV=dev
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/openclaw_app
REDIS_URL=redis://redis:6379/0
LITELLM_BASE_URL=http://litellm:4000
SANDBOX_IMAGE=openclaw-sandbox:latest
SANDBOX_NETWORK=openclaw_app_default
SANDBOX_COMMAND_TEMPLATE=openclaw agent --local --agent main --message "{message}" --json --timeout 120
FREE_DAILY_TASK_LIMIT=5
SANDBOX_IDLE_PAUSE_MINUTES=15
